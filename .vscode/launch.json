{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Budget (https)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prelaunch: full stack",
            "program": "${workspaceFolder}/Budget.Server/bin/Debug/net10.0/Budget.Server.dll",
            "cwd": "${workspaceFolder}/Budget.Server",
            "stopAtEntry": false,
            "console": "externalTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_HOSTINGSTARTUPASSEMBLIES": "Microsoft.AspNetCore.SpaProxy",
                "ASPNETCORE_URLS": "https://localhost:7177;http://localhost:5256"
            }
        }
    ]
}
