{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=budget;Trusted_Connection=True;"
    },
    "AllowedOrigins": "https://localhost:49835",
    "ReverseProxy": {
        "TrustedProxies": []
    },
    "ClientUrl": "https://localhost:49835",
    "Auth": {
        "AccessToken": {
            "SecretKey": "i-am-but-a-simple-dev-key-mate",
            "ExpirationInSeconds": 900,
            "Issuer": "budget-server",
            "Audience": "budget-client"
        },
        "RefreshToken": {
            "CookieKey": "refreshToken",
            "ExpirationInSeconds": 604800,
            "CleanupCronExpression": "0 * * * *"
        },
        "ResetPassword": {
            "ExpirationInSeconds": 3600
        },
        "EmailConfirmation": {
            "ExpirationInSeconds": 86400
        }
    },
    "RateLimiter": {
        "Register": {
            "TentativeCount": 3,
            "ResetInSeconds": 600
        },
        "Login": {
            "TentativeCount": 5,
            "ResetInSeconds": 60
        },
        "ForgotPassword": {
            "TentativeCount": 3,
            "ResetInSeconds": 600
        },
        "ResetPassword": {
            "TentativeCount": 3,
            "ResetInSeconds": 600
        },
        "ConfirmEmail": {
            "TentativeCount": 3,
            "ResetInSeconds": 600
        },
        "ResendEmailConfirmation": {
            "TentativeCount": 3,
            "ResetInSeconds": 600
        }
    },
    "Smtp": {
        "Host": "localhost",
        "Port": 587,
        "EnableSsl": true,
        "Username": "",
        "Password": "",
        "FromAddress": "no-reply@example.com",
        "FromName": "Budget"
    }
}
